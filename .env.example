NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://store:store@localhost:5432/store
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=3000
TRUST_PROXY=127.0.0.1
PROVIDER_A_ERROR_RATE=0.3
PROVIDER_A_TIMEOUT_RATE=0.2
PROVIDER_B_ERROR_RATE=0.1
PROVIDER_B_TIMEOUT_RATE=0.1
PROVIDER_TIMEOUT_MS=3000
PROVIDER_MAX_ATTEMPTS=3
DELIVERY_SWEEP_INTERVAL_MS=15000
DELIVERY_STUCK_AFTER_MS=60000
ORDER_EXPIRES_AFTER_MS=1800000
RESERVATION_TTL_MS=300000
RESERVATION_SWEEP_INTERVAL_MS=2000
SSE_HEARTBEAT_MS=15000
SSE_RETRY_MS=3000
CATALOG_EVENT_RETENTION_MS=3600000

LOG_LEVEL=info
