{
  "name": "digital-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "openapi:types": "openapi-typescript openapi.yaml -o src/types/api.d.ts",
    "openapi:lint": "redocly lint openapi.yaml",
    "race": "node --env-file-if-exists=.env scripts/race.ts",
    "race:last-unit": "node --env-file-if-exists=.env scripts/last-unit.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@scalar/fastify-api-reference": "1.67.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.1",
    "fastify-plugin": "^6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "yaml": "^2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "2.49.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "globals": "^17.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
